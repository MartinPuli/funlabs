{
  "name": "funlabs",
  "version": "0.1.0",
  "private": true,
  "description": "FUNLABS: human playtests, evidence and version comparisons for agents that build interactive experiences.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "checks": "node scripts/run-checks.mjs",
    "worker": "node scripts/worker.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "vitest run tests/db",
    "gen:builds": "node scripts/gen-builds.mjs",
    "test:agentic": "node scripts/run-agentic.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "ai": "7.0.127",
    "next": "16.3.8",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@e2e-dev/web": "^0.11.2",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "e2e": "^0.16.0",
    "supabase": "2.119.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
