{
  "game": "gravity-room",
  "description": "Recorrido conocido que completa las tres salas. Se fija antes de cualquier intervención y el agente que modifica el juego no puede editarlo. Verifica un recorrido, no que todos los caminos sean resolubles.",
  "route": [
    { "do": "press", "action": "start", "note": "Sala 1: empezar" },
    { "do": "press", "action": "flip" },
    { "do": "until", "keys": ["right"], "cond": { "grounded": true, "gravity": "up" }, "max": 200 },
    { "do": "until", "keys": ["right"], "cond": { "colGte": 6 }, "max": 200 },
    { "do": "press", "action": "interact", "note": "Sala 1: interruptor del techo" },
    { "do": "expect", "cond": { "doorOpen": true } },
    { "do": "until", "keys": ["right"], "cond": { "colGte": 15 }, "max": 300 },
    { "do": "press", "action": "flip" },
    { "do": "until", "keys": ["right"], "cond": { "level": 2 }, "max": 600, "note": "Sala 1: salida" },

    { "do": "press", "action": "flip", "note": "Sala 2" },
    { "do": "until", "keys": ["right"], "cond": { "grounded": true, "gravity": "up" }, "max": 200 },
    { "do": "until", "keys": ["right"], "cond": { "colGte": 8 }, "max": 200 },
    { "do": "release", "frames": 20 },
    { "do": "press", "action": "flip" },
    { "do": "until", "cond": { "grounded": true, "gravity": "down" }, "max": 200 },
    { "do": "until", "keys": ["right"], "cond": { "colGte": 12 }, "max": 200 },
    { "do": "release", "frames": 15 },
    { "do": "press", "action": "flip", "note": "Sala 2: debajo de la plataforma" },
    { "do": "until", "cond": { "grounded": true, "gravity": "up" }, "max": 200 },
    { "do": "until", "keys": ["right"], "cond": { "colGte": 15 }, "max": 200 },
    { "do": "press", "action": "interact", "note": "Sala 2: interruptor bajo la plataforma" },
    { "do": "expect", "cond": { "doorOpen": true } },
    { "do": "until", "keys": ["right"], "cond": { "level": 3 }, "max": 600, "note": "Sala 2: salida por el techo" },

    { "do": "press", "action": "flip", "note": "Sala 3" },
    { "do": "until", "keys": ["right"], "cond": { "grounded": true, "gravity": "up" }, "max": 200 },
    { "do": "until", "keys": ["right"], "cond": { "colGte": 25 }, "max": 200 },
    { "do": "press", "action": "flip" },
    { "do": "until", "keys": ["right"], "cond": { "grounded": true, "gravity": "down" }, "max": 200 },
    { "do": "press", "action": "interact", "note": "Sala 3: interruptor derecho" },
    { "do": "expect", "cond": { "switchesOn": 1 } },
    { "do": "press", "action": "flip" },
    { "do": "until", "keys": ["left"], "cond": { "grounded": true, "gravity": "up" }, "max": 200 },
    { "do": "until", "keys": ["left"], "cond": { "colLte": 19 }, "max": 200 },
    { "do": "press", "action": "flip", "note": "Sala 3: bajar a la plataforma" },
    { "do": "until", "keys": ["left"], "cond": { "grounded": true, "gravity": "down" }, "max": 200 },
    { "do": "until", "keys": ["left"], "cond": { "grounded": false }, "max": 200 },
    { "do": "until", "cond": { "grounded": true }, "max": 200, "note": "Sala 3: caer sin avanzar para evitar los pinchos" },
    { "do": "press", "action": "flip" },
    { "do": "until", "keys": ["left"], "cond": { "grounded": true, "gravity": "up" }, "max": 200 },
    { "do": "until", "keys": ["left"], "cond": { "colLte": 1 }, "max": 200 },
    { "do": "press", "action": "interact", "note": "Sala 3: interruptor izquierdo" },
    { "do": "expect", "cond": { "doorOpen": true } },
    { "do": "release", "frames": 5 },
    { "do": "press", "action": "flip" },
    { "do": "until", "cond": { "status": "complete" }, "max": 300, "note": "Fin" }
  ],
  "deathRoute": [
    { "do": "press", "action": "start" },
    { "do": "until", "keys": ["right"], "cond": { "deaths": 1 }, "max": 400, "note": "Caminar hacia los pinchos del piso" },
    { "do": "expect", "cond": { "status": "dying" } },
    { "do": "release", "frames": 60 },
    { "do": "expect", "cond": { "status": "playing", "level": 1, "colLte": 2 } }
  ]
}
