# Copy to .env.local (never commit real values).

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Backend identity (a user with app_metadata.funlabs_role = 'worker'); see docs/ARCHITECTURE.md
FUNLABS_WORKER_EMAIL=worker@funlabs.local
FUNLABS_WORKER_PASSWORD=
# Local tooling and tests only. Not needed in production.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Jobs -------------------------------------------------------------------
# Shared secret that pg_cron/pg_net send to /api/jobs/tick (also stored in Supabase Vault).
FUNLABS_CRON_SECRET=
# Where jobs run, reported on every job and check (defaults: vercel-function or local).
# FUNLABS_RUNNER=

# --- Models (optional: without them /estado shows "no configurada") ---------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# FUNLABS_ANALYSIS_MODEL=gemini-3.8-flash
# FUNLABS_INTERVENTION_MODEL=claude-opus-5-5
# On Vercel, AI Gateway works with the project's OIDC token and no keys.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (test mode only; not integrated yet) ----------------------------
# STRIPE_SECRET_KEY=sk_test_...
